<Window x:Class="CartridgeCreator.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Steam Game Cartridge Creator"
        Width="980"
        Height="720"
        MinWidth="860"
        MinHeight="620">
  <Grid Margin="16">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="160" />
    </Grid.RowDefinitions>

    <DockPanel Grid.Row="0" LastChildFill="False" Margin="0,0,0,12">
      <StackPanel DockPanel.Dock="Left">
        <TextBlock Text="Steam Game Cartridge Creator"
                   FontSize="22"
                   FontWeight="SemiBold" />
        <TextBlock Text="Select one installed Steam game and one USB target disk."
                   Margin="0,4,0,0"
                   Foreground="#555" />
      </StackPanel>
      <Button x:Name="RefreshButton"
              DockPanel.Dock="Right"
              Content="Refresh"
              Width="110"
              Height="34"
              Click="RefreshButton_Click" />
    </DockPanel>

    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="2*" />
        <ColumnDefinition Width="16" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>

      <TextBlock Grid.Column="0"
                 Text="Installed Steam Games"
                 FontWeight="SemiBold"
                 Margin="0,0,0,6" />
      <ListBox x:Name="GamesList"
               Grid.Column="0"
               Grid.Row="1"
               ItemsSource="{Binding Games}"
               DisplayMemberPath="DisplayName" />

      <TextBlock Grid.Column="2"
                 Text="USB Target Disks"
                 FontWeight="SemiBold"
                 Margin="0,0,0,6" />
      <ListBox x:Name="DisksList"
               Grid.Column="2"
               Grid.Row="1"
               ItemsSource="{Binding Disks}"
               DisplayMemberPath="DisplayName" />
    </Grid>

    <DockPanel Grid.Row="2" Margin="0,12,0,12" LastChildFill="False">
      <CheckBox x:Name="HashCheckBox"
                DockPanel.Dock="Left"
                Content="Create and require SHA256 hash manifest for files below 100 MiB"
                VerticalAlignment="Center"
                IsChecked="True" />
      <Button x:Name="CreateButton"
              DockPanel.Dock="Right"
              Content="Create Cartridge"
              Width="160"
              Height="38"
              Click="CreateButton_Click" />
      <ProgressBar x:Name="ProgressBar"
                   DockPanel.Dock="Right"
                   Width="220"
                   Height="14"
                   Margin="0,0,16,0"
                   IsIndeterminate="False" />
    </DockPanel>

    <TextBox x:Name="LogBox"
             Grid.Row="3"
             IsReadOnly="True"
             AcceptsReturn="True"
             TextWrapping="Wrap"
             VerticalScrollBarVisibility="Auto"
             FontFamily="Consolas"
             FontSize="12" />
  </Grid>
</Window>
